<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UssdUPI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="colorPrimary">@color/accent_grey</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
    </style>

    <style name="ShapeAppearance.BottomRoundedCard" parent="">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <style name="Widget.App.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/white</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
    </style>
</resources>